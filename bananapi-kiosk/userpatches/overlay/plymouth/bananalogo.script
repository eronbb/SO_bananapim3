Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

img = Image("logo.png");
sw = Window.GetWidth();
sh = Window.GetHeight();
s = Math.Min(sw / img.GetWidth(), sh / img.GetHeight());
scaled = img.Scale(img.GetWidth() * s, img.GetHeight() * s);
sprite = Sprite(scaled);
sprite.SetX(sw / 2 - scaled.GetWidth() / 2);
sprite.SetY(sh / 2 - scaled.GetHeight() / 2);
